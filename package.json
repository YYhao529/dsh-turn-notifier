{
  "name": "dsh-turn-notifier",
  "version": "0.1.0",
  "private": true,
  "description": "任务完成提醒：DSH 会话的回合结束时，即使窗口在后台也弹出提醒卡片，并显示本次与今日累计花费。",
  "icon": "icon.svg",
  "type": "module",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "lib/card.ps1",
    "lib/cost.js",
    "lib/ledger.js",
    "lib/backfill.js",
    "lib/log-frames.js",
    "cordis.patch.yml",
    "icon.svg",
    "README.md"
  ],
  "scripts": {
    "test": "node test/smoke.mjs && node test/cost.mjs && node test/backfill.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-connection"
      ]
    }
  },
  "license": "MIT"
}
