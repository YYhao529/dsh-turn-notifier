{
  "name": "dsh-turn-notifier",
  "version": "0.1.0",
  "private": true,
  "description": "任务完成提醒：DSH 会话的回合结束时，即使窗口在后台也弹出系统通知。",
  "icon": "icon.svg",
  "type": "module",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./icon": "./icon.svg"
  },
  "files": ["index.js", "client.js", "cordis.patch.yml", "icon.svg", "README.md"],
  "scripts": {
    "test": "node test/smoke.mjs"
  },
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": ["@deepseek-ai/dsh-client-connection"]
    }
  },
  "license": "MIT"
}
